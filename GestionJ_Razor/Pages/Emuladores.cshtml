@* Pages/Emuladores.cshtml *@
@page
@model GestionJ_Razor.Pages.EmuladoresModel
@{
    ViewData["Title"] = "Emuladores";
    var esAdmin = HttpContext.Session.GetString("RolId") == "1";
    var estaLogueado = !string.IsNullOrEmpty(HttpContext.Session.GetString("Usuario"));
}

<style>
    .emuladores-container { max-width: 1200px; margin: 0 auto; padding: 50px 20px; }
    .page-hero { text-align: center; margin-bottom: 50px; }
    .page-hero h1 { font-size: 2.5rem; font-weight: 900; color: white; margin-bottom: 10px; }
    .page-hero h1 span { color: #c0392b; }
    .page-hero p { color: rgba(255,255,255,0.5); font-size: 1.1rem; }
    .aviso-login {
        background: rgba(192,57,43,0.1);
        border: 1px solid rgba(192,57,43,0.2);
        border-radius: 12px;
        padding: 20px 25px;
        text-align: center;
        margin-bottom: 40px;
        color: rgba(255,255,255,0.7);
        font-size: 0.95rem;
    }
    .aviso-login a { color: #c0392b; text-decoration: none; font-weight: 700; }
    /* Panel admin */
    .admin-panel {
        background: #12121f;
        border: 1px solid rgba(192,57,43,0.3);
        border-radius: 14px;
        padding: 25px;
        margin-bottom: 40px;
    }
    .admin-panel-titulo {
        font-size: 1rem;
        font-weight: 700;
        color: #c0392b;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .form-admin { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .form-admin-full { grid-column: 1 / -1; }
    .input-admin {
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.15);
        color: white;
        border-radius: 8px;
        padding: 10px 14px;
        width: 100%;
        font-size: 0.9rem;
    }
    .input-admin:focus { outline: none; border-color: #c0392b; }
    .select-admin {
        background: #1a1a2e;
        border: 1px solid rgba(255,255,255,0.15);
        color: white;
        border-radius: 8px;
        padding: 10px 14px;
        width: 100%;
        font-size: 0.9rem;
    }
    .label-admin { font-size: 0.8rem; color: rgba(255,255,255,0.5); margin-bottom: 5px; display: block; }
    .btn-admin-guardar {
        background: #c0392b;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
    }
    .btn-admin-guardar:hover { background: #a93226; }
    .btn-admin-cancelar {
        background: transparent;
        color: rgba(255,255,255,0.5);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 8px;
        padding: 10px 20px;
        cursor: pointer;
    }
    /* Grilla emuladores */
    .emuladores-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
        gap: 25px;
    }
    .emulador-card {
        background: #12121f;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.2s;
    }
    .emulador-card:hover { border-color: rgba(192,57,43,0.4); transform: translateY(-3px); }
    .emulador-header {
        background: linear-gradient(135deg, #1a0505, #0d0d1a);
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .emulador-img {
        width: 70px;
        height: 70px;
        border-radius: 12px;
        object-fit: cover;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        flex-shrink: 0;
        overflow: hidden;
    }
    .emulador-img img { width: 100%; height: 100%; object-fit: cover; }
    .emulador-nombre { font-size: 1.2rem; font-weight: 800; color: white; }
    .emulador-version { font-size: 0.8rem; color: rgba(255,255,255,0.4); margin-top: 3px; }
    .emulador-body { padding: 18px 20px; }
    .emulador-info-row { display: flex; justify-content: space-between; margin-bottom: 8px; }
    .emulador-dato { font-size: 0.85rem; color: rgba(255,255,255,0.5); }
    .emulador-dato span { color: white; font-weight: 600; }
    .plataforma-tag {
        display: inline-block;
        background: rgba(192,57,43,0.15);
        color: #c0392b;
        border: 1px solid rgba(192,57,43,0.3);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 12px;
    }
    .emulador-footer {
        padding: 15px 20px;
        border-top: 1px solid rgba(255,255,255,0.05);
        display: flex;
        gap: 8px;
    }
    .btn-descargar {
        background: #c0392b;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 18px;
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 7px;
        transition: background 0.2s;
        flex: 1;
        justify-content: center;
    }
    .btn-descargar:hover { background: #a93226; color: white; }
    .btn-descargar-disabled {
        background: rgba(255,255,255,0.07);
        color: rgba(255,255,255,0.3);
        border: none;
        border-radius: 8px;
        padding: 10px 18px;
        font-size: 0.9rem;
        flex: 1;
        text-align: center;
        cursor: not-allowed;
    }
    .btn-edit-sm {
        background: rgba(255,193,7,0.15);
        color: #ffc107;
        border: 1px solid rgba(255,193,7,0.3);
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-edit-sm:hover { background: rgba(255,193,7,0.25); }
    .btn-del-sm {
        background: rgba(192,57,43,0.15);
        color: #c0392b;
        border: 1px solid rgba(192,57,43,0.3);
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-del-sm:hover { background: rgba(192,57,43,0.25); }
    /* Popup borrar */
    .popup-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.7);
        display: flex; align-items: center; justify-content: center;
        z-index: 9999;
    }
    .popup-box {
        background: #12121f;
        border: 1px solid rgba(192,57,43,0.4);
        border-radius: 16px;
        padding: 35px;
        max-width: 400px;
        width: 90%;
        text-align: center;
        color: white;
    }
    .popup-box h4 { margin-bottom: 10px; }
    .popup-box p { color: rgba(255,255,255,0.5); margin-bottom: 25px; }
    .popup-btns { display: flex; gap: 12px; justify-content: center; }
</style>

<div class="emuladores-container">
    <div class="page-hero">
        <h1>💻 <span>Emuladores</span> disponibles</h1>
        <p>Descargá el emulador para tu consola favorita y empezá a jugar</p>
    </div>

    <form method="POST">
        @Html.AntiForgeryToken()

        @if (!estaLogueado)
        {
            <div class="aviso-login">
                ⚠️ Para descargar emuladores necesitás
                <a href="#" data-bs-toggle="modal" data-bs-target="#modalLogin">iniciar sesión</a>
                o <a asp-page="/Registro">crear una cuenta gratis</a>.
            </div>
        }

        @* PANEL ADMIN *@
        @if (esAdmin)
        {
            <div class="admin-panel">
                <div class="admin-panel-titulo">⚙️ Panel de administración — Emuladores</div>

                @if (Model.Emulador == null)
                {
                    <button type="submit" asp-page-handler="BtNuevo" class="btn-admin-guardar">
                        + Agregar emulador
                    </button>
                }
                else
                {
                    <input type="hidden" asp-for="Emulador.Id" />
                    <div class="form-admin">
                        <div>
                            <label class="label-admin">Nombre</label>
                            <input class="input-admin" asp-for="Emulador.Nombre" />
                        </div>
                        <div>
                            <label class="label-admin">Version</label>
                            <input type="number" step="0.01" class="input-admin" asp-for="Emulador.Version" />
                        </div>
                        <div>
                            <label class="label-admin">Plataforma</label>
                            <select class="select-admin" asp-for="Emulador.PlataformaId">
                                @if (Model.ListaPlataformas != null)
                                {
                                    @foreach (var p in Model.ListaPlataformas)
                                    {
                                        <option value="@p.Id">@p.NombrePlataforma</option>
                                    }
                                }
                            </select>
                        </div>
                        <div>
                            <label class="label-admin">Bios</label>
                            <input class="input-admin" asp-for="Emulador.Bios" />
                        </div>
                        <div>
                            <label class="label-admin">Region Bios</label>
                            <input class="input-admin" asp-for="Emulador.RegionBios" />
                        </div>
                        <div style="display:flex; align-items:flex-end; gap:8px;">
                            <button type="submit" asp-page-handler="BtGuardar" class="btn-admin-guardar">
                                Guardar
                            </button>
                            <button type="submit" asp-page-handler="BtCerrar" class="btn-admin-cancelar">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }
            </div>
        }

        @* POPUP BORRAR *@
        @if (Model.Borrando && Model.Emulador != null)
        {
            <div class="popup-overlay">
                <div class="popup-box">
                    <h4>¿Borrar emulador?</h4>
                    <p>@Model.Emulador.Nombre será eliminado permanentemente.</p>
                    <input type="hidden" asp-for="Emulador.Id" />
                    <div class="popup-btns">
                        <button type="submit" asp-page-handler="BtCerrar" class="btn-admin-cancelar">
                            Cancelar
                        </button>
                        <button type="submit" asp-page-handler="BtBorrar" class="btn-admin-guardar">
                            Sí, borrar
                        </button>
                    </div>
                </div>
            </div>
        }

        @* LISTA EMULADORES *@
        @if (Model.ListaEmuladores != null && Model.ListaEmuladores.Count > 0)
        {
            <div class="emuladores-grid">
                @foreach (var emulador in Model.ListaEmuladores)
                {
                    var plataforma = Model.ListaPlataformas?
                        .FirstOrDefault(p => p.Id == emulador.PlataformaId);

                    var icono = plataforma?.NombrePlataforma switch {
                        var n when n != null && n.Contains("PlayStation") => "🔵",
                        var n when n != null && n.Contains("Nintendo") => "🔴",
                        var n when n != null && n.Contains("Xbox") => "🟢",
                        var n when n != null && n.Contains("Game Boy") => "🟡",
                        var n when n != null && n.Contains("Sega") => "⚫",
                        _ => "💻"
                    };

                    var nombreArchivo = emulador.Nombre?.ToLower()
                        .Replace(" ", "_")
                        .Replace(".", "") + ".zip";

                    // Imagen: wwwroot/img/emuladores/pcsx2.png etc
                    var nombreImg = emulador.Nombre?.ToLower()
                        .Replace(" ", "_")
                        .Replace(".", "") + ".png";

                    <div class="emulador-card">
                        <div class="emulador-header">
                            <div class="emulador-img">
                                <img src="~/img/emuladores/@nombreImg"
                                     alt="@emulador.Nombre"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <span style="display:none; width:100%; height:100%; align-items:center; justify-content:center; font-size:2rem;">
                                    @icono
                                </span>
                            </div>
                            <div>
                                <div class="emulador-nombre">@emulador.Nombre</div>
                                <div class="emulador-version">Versión @emulador.Version</div>
                            </div>
                        </div>
                        <div class="emulador-body">
                            @if (plataforma != null)
                            {
                                <span class="plataforma-tag">@plataforma.NombrePlataforma</span>
                            }
                            <div class="emulador-info-row">
                                <span class="emulador-dato">BIOS: <span>@emulador.Bios</span></span>
                                <span class="emulador-dato">Región: <span>@emulador.RegionBios</span></span>
                            </div>
                        </div>
                        <div class="emulador-footer">
                            @if (estaLogueado)
                            {
                                <a class="btn-descargar"
                                   href="~/descargas/emuladores/@nombreArchivo"
                                   download>
                                    ⬇️ Descargar
                                </a>
                            }
                            else
                            {
                                <div class="btn-descargar-disabled">
                                    🔒 Iniciá sesión para descargar
                                </div>
                            }
                            @if (esAdmin)
                            {
                                <button type="submit"
                                        asp-page-handler="BtModificar"
                                        asp-route-data="@emulador.Id"
                                        class="btn-edit-sm">
                                    ✏️
                                </button>
                                <button type="submit"
                                        asp-page-handler="BtBorrarVal"
                                        asp-route-data="@emulador.Id"
                                        class="btn-del-sm">
                                    🗑️
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="text-align:center; padding:60px; color:rgba(255,255,255,0.3);">
                <div style="font-size:3rem; margin-bottom:15px;">💻</div>
                <p>No hay emuladores disponibles por ahora.</p>
            </div>
        }
    </form>
</div>