@* Pages/Ventanas/Admi/GestionesHTML.cshtml *@
@page
@model GestionJ_Razor.Pages.Ventanas.Admi.GestionesHTMLModel
@{ ViewData["Title"] = "Gestiones"; }
<center><div><form method="POST" enctype="multipart/form-data">
@Html.AntiForgeryToken()
<div align="left"><h3>Gestiones</h3></div>
<div>
    <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
    <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Gestion != null)" />
    <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" disabled="@(Model.Gestion == null)" />
</div>
@if (Model.Gestion != null)
{
    <input type="hidden" asp-for="@Model.Gestion!.Id" /><br />
    <div class="form-group"><label>Accion</label><div class="col-6"><input class="form-control" asp-for="@Model.Gestion!.Accion" /></div></div>
    <div class="form-group"><label>Fecha Gestion</label><div class="col-6"><input type="date" class="form-control" asp-for="@Model.Gestion!.FechaGestion" /></div></div>
    <div class="form-group"><label>Resultado</label><div class="col-6"><input type="checkbox" asp-for="@Model.Gestion!.Resultado" /></div></div>
    <div class="form-group"><label>Usuario</label><div class="col-6"><select class="form-control" asp-for="@Model.Gestion!.UsuarioId">@if (Model.ListaUsuarios != null) { @foreach (var u in Model.ListaUsuarios) { <option value="@u.Id">@u.Nombre @u.Apellido</option> } }</select></div></div>
}
@if (ViewData.ContainsKey("Mensaje")) { <div class="alert alert-danger mt-2">@ViewData["Mensaje"]</div> }
@if (Model.Gestion != null && Model.Borrando)
{
    <div class="popup"><div class="pp_ms_inner"><div style="width:95%"><h2 align="left">Mensaje</h2><h6 align="left">¿Desea borrar la Gestion?</h6><h6 align="left">@Model.Gestion!.Accion</h6>
    <input type="submit" value="Cerrar" asp-page-handler="BtCerrar" class="btn btn-secondary" />
    <input type="submit" value="Borrar" asp-page-handler="BtBorrar" class="btn btn-danger" /></div></div></div>
}
@if (Model.Lista != null && Model.Lista.Count > 0)
{
    <br /><table class="table table-striped table-bordered table-hover">
    <tr><th>Id</th><th>Accion</th><th>Fecha</th><th>Resultado</th><th>Acciones</th></tr>
    @foreach (var e in Model.Lista) {
        <tr><td>@e.Id</td><td>@e.Accion</td><td>@e.FechaGestion</td><td>@(e.Resultado ? "✔" : "✘")</td>
        <td><input type="submit" value="Modificar" asp-page-handler="BtModificar" class="btn btn-warning btn-sm" asp-route-data="@e.Id" />
        <input type="submit" value="Borrar" asp-page-handler="BtBorrarVal" class="btn btn-danger btn-sm" asp-route-data="@e.Id" /></td></tr>
    }
    </table>
}
</form></div></center>