@* Pages/Ventanas/Admi/GestorArchivosHTML.cshtml *@
@page
@model GestionJ_Razor.Pages.Ventanas.Admi.GestorArchivosHTMLModel
@{
    ViewData["Title"] = "Gestor Archivos";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Gestor Archivos</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
                <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.GestorArchivo != null)" />
                <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" disabled="@(Model.GestorArchivo == null)" />
            </div>

            @if (Model.GestorArchivo != null)
            {
                <input type="hidden" asp-for="@Model.GestorArchivo!.Id" />
                <br />
                <div>
                    <div class="form-group">
                        <label>Nombre Archivo</label>
                        <div class="col-6">
                            <input class="form-control" asp-for="@Model.GestorArchivo!.NombreArchivo" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Tipo Archivo</label>
                        <div class="col-6">
                            <input class="form-control" asp-for="@Model.GestorArchivo!.TipoArchivo" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Tamanio</label>
                        <div class="col-6">
                            <input class="form-control" asp-for="@Model.GestorArchivo!.Tamanio" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Ruta Archivo</label>
                        <div class="col-6">
                            <input class="form-control" asp-for="@Model.GestorArchivo!.RutaArchivo" />
                        </div>
                    </div>
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                <div class="alert alert-danger mt-2">
                    @ViewData["Mensaje"]
                </div>
            }

            @if (Model.GestorArchivo != null && Model.Borrando)
            {
                <div class="popup">
                    <div class="pp_ms_inner">
                        <div style="width:95%">
                            <h2 align="left">Mensaje</h2>
                            <h6 align="left">¿Desea borrar el Archivo?</h6>
                            <h6 align="left">@Model.GestorArchivo!.NombreArchivo</h6>
                            <input type="submit" value="Cerrar" asp-page-handler="BtCerrar" class="btn btn-secondary" />
                            <input type="submit" value="Borrar" asp-page-handler="BtBorrar" class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <br />
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Id</th>
                        <th>Nombre Archivo</th>
                        <th>Tipo</th>
                        <th>Tamanio</th>
                        <th>Ruta</th>
                        <th>Acciones</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Id</td>
                            <td>@elemento.NombreArchivo</td>
                            <td>@elemento.TipoArchivo</td>
                            <td>@elemento.Tamanio</td>
                            <td>@elemento.RutaArchivo</td>
                            <td>
                                <input type="submit" value="Modificar" asp-page-handler="BtModificar" class="btn btn-warning btn-sm" asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar" asp-page-handler="BtBorrarVal" class="btn btn-danger btn-sm" asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>