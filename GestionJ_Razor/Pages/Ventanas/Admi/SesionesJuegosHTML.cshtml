@* Pages/Ventanas/Admi/SesionesJuegosHTML.cshtml *@
@page
@model GestionJ_Razor.Pages.Ventanas.Admi.SesionesJuegosHTMLModel
@{ ViewData["Title"] = "Sesiones Juegos"; }
<center><div><form method="POST" enctype="multipart/form-data">
@Html.AntiForgeryToken()
<div align="left"><h3>Sesiones Juegos</h3></div>
<div>
    <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
    <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Sesion != null)" />
    <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" disabled="@(Model.Sesion == null)" />
</div>
@if (Model.Sesion != null)
{
    <input type="hidden" asp-for="@Model.Sesion!.Id" /><br />
    <div class="form-group"><label>Nombre Juego</label><div class="col-6"><input class="form-control" asp-for="@Model.Sesion!.NombreJuego" /></div></div>
    <div class="form-group"><label>Duracion</label><div class="col-6"><input class="form-control" asp-for="@Model.Sesion!.Duracion" /></div></div>
    <div class="form-group"><label>Videojuego</label><div class="col-6"><select class="form-control" asp-for="@Model.Sesion!.VideojuegoId">@if (Model.ListaVideojuegos != null) { @foreach (var v in Model.ListaVideojuegos) { <option value="@v.Id">@v.Titulo</option> } }</select></div></div>
    <div class="form-group"><label>Usuario</label><div class="col-6"><select class="form-control" asp-for="@Model.Sesion!.UsuarioId">@if (Model.ListaUsuarios != null) { @foreach (var u in Model.ListaUsuarios) { <option value="@u.Id">@u.Nombre @u.Apellido</option> } }</select></div></div>
}
@if (ViewData.ContainsKey("Mensaje")) { <div class="alert alert-danger mt-2">@ViewData["Mensaje"]</div> }
@if (Model.Sesion != null && Model.Borrando)
{
    <div class="popup"><div class="pp_ms_inner"><div style="width:95%"><h2 align="left">Mensaje</h2><h6 align="left">¿Desea borrar la Sesion?</h6><h6 align="left">@Model.Sesion!.NombreJuego</h6>
    <input type="submit" value="Cerrar" asp-page-handler="BtCerrar" class="btn btn-secondary" />
    <input type="submit" value="Borrar" asp-page-handler="BtBorrar" class="btn btn-danger" /></div></div></div>
}
@if (Model.Lista != null && Model.Lista.Count > 0)
{
    <br /><table class="table table-striped table-bordered table-hover">
    <tr><th>Id</th><th>Nombre Juego</th><th>Duracion</th><th>Acciones</th></tr>
    @foreach (var e in Model.Lista) {
        <tr><td>@e.Id</td><td>@e.NombreJuego</td><td>@e.Duracion</td>
        <td><input type="submit" value="Modificar" asp-page-handler="BtModificar" class="btn btn-warning btn-sm" asp-route-data="@e.Id" />
        <input type="submit" value="Borrar" asp-page-handler="BtBorrarVal" class="btn btn-danger btn-sm" asp-route-data="@e.Id" /></td></tr>
    }
    </table>
}
</form></div></center>