@* Pages/Ventanas/Admi/PermisosHTML.cshtml *@
@page
@model GestionJ_Razor.Pages.Ventanas.Admi.PermisosHTMLModel
@{ ViewData["Title"] = "Permisos"; }
<center><div><form method="POST" enctype="multipart/form-data">
@Html.AntiForgeryToken()
<div align="left"><h3>Permisos</h3></div>
<div>
    <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
    <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Permiso != null)" />
    <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" disabled="@(Model.Permiso == null)" />
</div>
@if (Model.Permiso != null)
{
    <input type="hidden" asp-for="@Model.Permiso!.Id" /><br />
    <div class="form-group"><label>Nombre Permiso</label><div class="col-6"><input class="form-control" asp-for="@Model.Permiso!.NombrePermiso" /></div></div>
    <div class="form-group"><label>Descripcion</label><div class="col-6"><input class="form-control" asp-for="@Model.Permiso!.Descripcion" /></div></div>
    <div class="form-group"><label>Rol</label><div class="col-6"><select class="form-control" asp-for="@Model.Permiso!.RolId">@if (Model.ListaRoles != null) { @foreach (var r in Model.ListaRoles) { <option value="@r.Id">@r.NombreRol</option> } }</select></div></div>
}
@if (ViewData.ContainsKey("Mensaje")) { <div class="alert alert-danger mt-2">@ViewData["Mensaje"]</div> }
@if (Model.Permiso != null && Model.Borrando)
{
    <div class="popup"><div class="pp_ms_inner"><div style="width:95%"><h2 align="left">Mensaje</h2><h6 align="left">¿Desea borrar el Permiso?</h6><h6 align="left">@Model.Permiso!.NombrePermiso</h6>
    <input type="submit" value="Cerrar" asp-page-handler="BtCerrar" class="btn btn-secondary" />
    <input type="submit" value="Borrar" asp-page-handler="BtBorrar" class="btn btn-danger" /></div></div></div>
}
@if (Model.Lista != null && Model.Lista.Count > 0)
{
    <br /><table class="table table-striped table-bordered table-hover">
    <tr><th>Id</th><th>Nombre Permiso</th><th>Descripcion</th><th>Acciones</th></tr>
    @foreach (var e in Model.Lista) {
        <tr><td>@e.Id</td><td>@e.NombrePermiso</td><td>@e.Descripcion</td>
        <td><input type="submit" value="Modificar" asp-page-handler="BtModificar" class="btn btn-warning btn-sm" asp-route-data="@e.Id" />
        <input type="submit" value="Borrar" asp-page-handler="BtBorrarVal" class="btn btn-danger btn-sm" asp-route-data="@e.Id" /></td></tr>
    }
    </table>
}
</form></div></center>