@* Pages/Ventanas/Admi/NotificacionesHTML.cshtml *@
@page
@model GestionJ_Razor.Pages.Ventanas.Admi.NotificacionesHTMLModel
@{ ViewData["Title"] = "Notificaciones"; }
<center><div><form method="POST" enctype="multipart/form-data">
@Html.AntiForgeryToken()
<div align="left"><h3>Notificaciones</h3></div>
<div>
    <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
    <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Notificacion != null)" />
    <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" disabled="@(Model.Notificacion == null)" />
</div>
@if (Model.Notificacion != null)
{
    <input type="hidden" asp-for="@Model.Notificacion!.Id" /><br />
    <div class="form-group"><label>Titulo</label><div class="col-6"><input class="form-control" asp-for="@Model.Notificacion!.Titulo" /></div></div>
    <div class="form-group"><label>Contenido</label><div class="col-6"><input class="form-control" asp-for="@Model.Notificacion!.Contenido" /></div></div>
    <div class="form-group"><label>Mensaje</label><div class="col-6"><input class="form-control" asp-for="@Model.Notificacion!.Mensaje" /></div></div>
    <div class="form-group"><label>Tipo Notificacion</label><div class="col-6"><input class="form-control" asp-for="@Model.Notificacion!.TipoNotificacion" /></div></div>
    <div class="form-group"><label>Fecha</label><div class="col-6"><input type="date" class="form-control" asp-for="@Model.Notificacion!.Fecha" /></div></div>
    <div class="form-group"><label>Usuario</label><div class="col-6"><select class="form-control" asp-for="@Model.Notificacion!.UsuarioId">@if (Model.ListaUsuarios != null) { @foreach (var u in Model.ListaUsuarios) { <option value="@u.Id">@u.Nombre @u.Apellido</option> } }</select></div></div>
}
@if (ViewData.ContainsKey("Mensaje")) { <div class="alert alert-danger mt-2">@ViewData["Mensaje"]</div> }
@if (Model.Notificacion != null && Model.Borrando)
{
    <div class="popup"><div class="pp_ms_inner"><div style="width:95%"><h2 align="left">Mensaje</h2><h6 align="left">¿Desea borrar la Notificacion?</h6><h6 align="left">@Model.Notificacion!.Titulo</h6>
    <input type="submit" value="Cerrar" asp-page-handler="BtCerrar" class="btn btn-secondary" />
    <input type="submit" value="Borrar" asp-page-handler="BtBorrar" class="btn btn-danger" /></div></div></div>
}
@if (Model.Lista != null && Model.Lista.Count > 0)
{
    <br /><table class="table table-striped table-bordered table-hover">
    <tr><th>Id</th><th>Titulo</th><th>Tipo</th><th>Fecha</th><th>Acciones</th></tr>
    @foreach (var e in Model.Lista) {
        <tr><td>@e.Id</td><td>@e.Titulo</td><td>@e.TipoNotificacion</td><td>@e.Fecha</td>
        <td><input type="submit" value="Modificar" asp-page-handler="BtModificar" class="btn btn-warning btn-sm" asp-route-data="@e.Id" />
        <input type="submit" value="Borrar" asp-page-handler="BtBorrarVal" class="btn btn-danger btn-sm" asp-route-data="@e.Id" /></td></tr>
    }
    </table>
}
</form></div></center>