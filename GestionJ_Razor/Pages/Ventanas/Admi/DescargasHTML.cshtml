@* Pages/Ventanas/Admi/DescargasHTML.cshtml *@
@page
@model GestionJ_Razor.Pages.Ventanas.Admi.DescargasHTMLModel
@{ ViewData["Title"] = "Descargas"; }
<center><div><form method="POST" enctype="multipart/form-data">
@Html.AntiForgeryToken()
<div align="left"><h3>Descargas</h3></div>
<div>
    <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
    <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Descarga != null)" />
    <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" disabled="@(Model.Descarga == null)" />
</div>
@if (Model.Descarga != null)
{
    <input type="hidden" asp-for="@Model.Descarga!.Id" /><br />
    <div class="form-group"><label>Servidor</label><div class="col-6"><input class="form-control" asp-for="@Model.Descarga!.Servidor" /></div></div>
    <div class="form-group"><label>Velocidad MB</label><div class="col-6"><input class="form-control" asp-for="@Model.Descarga!.VelocidadMB" /></div></div>
    <div class="form-group"><label>Estado Descarga</label><div class="col-6"><select class="form-control" asp-for="@Model.Descarga!.EstadoDescarga"><option value="Activa">Activa</option><option value="Pausada">Pausada</option><option value="Completada">Completada</option></select></div></div>
    <div class="form-group"><label>Fecha Instalacion</label><div class="col-6"><input type="date" class="form-control" asp-for="@Model.Descarga!.FechaInstalacion" /></div></div>
    <div class="form-group"><label>Usuario</label><div class="col-6"><select class="form-control" asp-for="@Model.Descarga!.UsuarioId">@if (Model.ListaUsuarios != null) { @foreach (var u in Model.ListaUsuarios) { <option value="@u.Id">@u.Nombre @u.Apellido</option> } }</select></div></div>
    <div class="form-group"><label>Rom</label><div class="col-6"><select class="form-control" asp-for="@Model.Descarga!.RomId">@if (Model.ListaRoms != null) { @foreach (var r in Model.ListaRoms) { <option value="@r.Id">@r.Nombre</option> } }</select></div></div>
}
@if (ViewData.ContainsKey("Mensaje")) { <div class="alert alert-danger mt-2">@ViewData["Mensaje"]</div> }
@if (Model.Descarga != null && Model.Borrando)
{
    <div class="popup"><div class="pp_ms_inner"><div style="width:95%"><h2 align="left">Mensaje</h2><h6 align="left">¿Desea borrar la Descarga?</h6><h6 align="left">@Model.Descarga!.Servidor</h6>
    <input type="submit" value="Cerrar" asp-page-handler="BtCerrar" class="btn btn-secondary" />
    <input type="submit" value="Borrar" asp-page-handler="BtBorrar" class="btn btn-danger" /></div></div></div>
}
@if (Model.Lista != null && Model.Lista.Count > 0)
{
    <br /><table class="table table-striped table-bordered table-hover">
    <tr><th>Id</th><th>Servidor</th><th>Velocidad</th><th>Estado</th><th>Fecha Instalacion</th><th>Acciones</th></tr>
    @foreach (var e in Model.Lista) {
        <tr><td>@e.Id</td><td>@e.Servidor</td><td>@e.VelocidadMB</td><td>@e.EstadoDescarga</td><td>@e.FechaInstalacion</td>
        <td><input type="submit" value="Modificar" asp-page-handler="BtModificar" class="btn btn-warning btn-sm" asp-route-data="@e.Id" />
        <input type="submit" value="Borrar" asp-page-handler="BtBorrarVal" class="btn btn-danger btn-sm" asp-route-data="@e.Id" /></td></tr>
    }
    </table>
}
</form></div></center>