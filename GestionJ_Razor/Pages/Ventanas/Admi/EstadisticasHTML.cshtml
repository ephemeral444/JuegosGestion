@* Pages/Ventanas/Admi/EstadisticasHTML.cshtml *@
@page
@model GestionJ_Razor.Pages.Ventanas.Admi.EstadisticasHTMLModel
@{ ViewData["Title"] = "Estadisticas"; }
<center><div><form method="POST" enctype="multipart/form-data">
@Html.AntiForgeryToken()
<div align="left"><h3>Estadisticas</h3></div>
<div>
    <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
    <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Estadistica != null)" />
    <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" disabled="@(Model.Estadistica == null)" />
</div>
@if (Model.Estadistica != null)
{
    <input type="hidden" asp-for="@Model.Estadistica!.Id" /><br />
    <div class="form-group"><label>Tiempo Juego</label><div class="col-6"><input class="form-control" asp-for="@Model.Estadistica!.TiempoJuego" /></div></div>
    <div class="form-group"><label>Juegos Completos</label><div class="col-6"><input class="form-control" asp-for="@Model.Estadistica!.JuegosCompletos" /></div></div>
    <div class="form-group"><label>Logros Obtenidos</label><div class="col-6"><input class="form-control" asp-for="@Model.Estadistica!.LogrosObtenidos" /></div></div>
    <div class="form-group"><label>Promedio FPS</label><div class="col-6"><input type="number" class="form-control" asp-for="@Model.Estadistica!.PromedioFPS" /></div></div>
    <div class="form-group"><label>Videojuego</label><div class="col-6"><select class="form-control" asp-for="@Model.Estadistica!.VideojuegoId">@if (Model.ListaVideojuegos != null) { @foreach (var v in Model.ListaVideojuegos) { <option value="@v.Id">@v.Titulo</option> } }</select></div></div>
}
@if (ViewData.ContainsKey("Mensaje")) { <div class="alert alert-danger mt-2">@ViewData["Mensaje"]</div> }
@if (Model.Estadistica != null && Model.Borrando)
{
    <div class="popup"><div class="pp_ms_inner"><div style="width:95%"><h2 align="left">Mensaje</h2><h6 align="left">¿Desea borrar la Estadistica?</h6>
    <input type="submit" value="Cerrar" asp-page-handler="BtCerrar" class="btn btn-secondary" />
    <input type="submit" value="Borrar" asp-page-handler="BtBorrar" class="btn btn-danger" /></div></div></div>
}
@if (Model.Lista != null && Model.Lista.Count > 0)
{
    <br /><table class="table table-striped table-bordered table-hover">
    <tr><th>Id</th><th>Tiempo Juego</th><th>Juegos Completos</th><th>Logros</th><th>FPS</th><th>Acciones</th></tr>
    @foreach (var e in Model.Lista) {
        <tr><td>@e.Id</td><td>@e.TiempoJuego</td><td>@e.JuegosCompletos</td><td>@e.LogrosObtenidos</td><td>@e.PromedioFPS</td>
        <td><input type="submit" value="Modificar" asp-page-handler="BtModificar" class="btn btn-warning btn-sm" asp-route-data="@e.Id" />
        <input type="submit" value="Borrar" asp-page-handler="BtBorrarVal" class="btn btn-danger btn-sm" asp-route-data="@e.Id" /></td></tr>
    }
    </table>
}
</form></div></center>