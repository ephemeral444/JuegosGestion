@* Pages/Ventanas/Admi/ConfiGeneralesHTML.cshtml *@
@page
@model GestionJ_Razor.Pages.Ventanas.Admi.ConfiGeneralesHTMLModel
@{
    ViewData["Title"] = "Confi Generales";
}
<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div align="left"><h3>Configuraciones Generales</h3></div>
            <div>
                <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
                <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.ConfiGeneral != null)" />
                <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" disabled="@(Model.ConfiGeneral == null)" />
            </div>
            @if (Model.ConfiGeneral != null)
            {
                <input type="hidden" asp-for="@Model.ConfiGeneral!.Id" /><br />
                <div class="form-group"><label>Idioma</label><div class="col-6"><input class="form-control" asp-for="@Model.ConfiGeneral!.Idioma" /></div></div>
                <div class="form-group"><label>Tema</label><div class="col-6"><select class="form-control" asp-for="@Model.ConfiGeneral!.Tema"><option value="Oscuro">Oscuro</option><option value="Claro">Claro</option></select></div></div>
                <div class="form-group"><label>Autoguardado</label><div class="col-6"><input type="date" class="form-control" asp-for="@Model.ConfiGeneral!.Autoguardado" /></div></div>
                <div class="form-group"><label>Version</label><div class="col-6"><input class="form-control" asp-for="@Model.ConfiGeneral!.Version" /></div></div>
            }
            @if (ViewData.ContainsKey("Mensaje"))
            {
                <div class="alert alert-danger mt-2">@ViewData["Mensaje"]</div>
            }
            @if (Model.ConfiGeneral != null && Model.Borrando)
            {
                <div class="popup">
                    <div class="pp_ms_inner">
                        <div style="width:95%">
                            <h2 align="left">Mensaje</h2><h6 align="left">¿Desea borrar la Configuracion?</h6><h6 align="left">@Model.ConfiGeneral!.Version</h6>
                            <input type="submit" value="Cerrar" asp-page-handler="BtCerrar" class="btn btn-secondary" />
                            <input type="submit" value="Borrar" asp-page-handler="BtBorrar" class="btn btn-danger" />
                        </div>
                    </div>
                </div>
            }
            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <br /><table class="table table-striped table-bordered table-hover">
                <tr><th>Id</th><th>Idioma</th><th>Tema</th><th>Version</th><th>Acciones</th></tr>
                @foreach (var e in Model.Lista)
                {
                    <tr>
                        <td>@e.Id</td>
                        <td>@e.Idioma</td>
                        <td>@e.Tema</td>
                        <td>@e.Version</td>
                        <td>
                            <input type="submit" value="Modificar" asp-page-handler="BtModificar" class="btn btn-warning btn-sm" asp-route-data="@e.Id" />
                            <input type="submit" value="Borrar" asp-page-handler="BtBorrarVal" class="btn btn-danger btn-sm" asp-route-data="@e.Id" />
                        </td>
                    </tr>
                }
            </table>
        }
    </form>    </div>
</center>