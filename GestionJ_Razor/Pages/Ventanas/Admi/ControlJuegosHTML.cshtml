@* Pages/Ventanas/Admi/ControlJuegosHTML.cshtml *@
@page
@model GestionJ_Razor.Pages.Ventanas.Admi.ControlJuegosHTMLModel
@{ ViewData["Title"] = "Control Juegos"; }
<center><div><form method="POST" enctype="multipart/form-data">
@Html.AntiForgeryToken()
<div align="left"><h3>Control Juegos</h3></div>
<div>
    <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
    <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.Control != null)" />
    <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" disabled="@(Model.Control == null)" />
</div>
@if (Model.Control != null)
{
    <input type="hidden" asp-for="@Model.Control!.Id" /><br />
    <div class="form-group"><label>FPS</label><div class="col-6"><input class="form-control" asp-for="@Model.Control!.Fps" /></div></div>
    <div class="form-group"><label>Controles</label><div class="col-6"><input class="form-control" asp-for="@Model.Control!.Controles" /></div></div>
    <div class="form-group"><label>Sensibilidad</label><div class="col-6"><input type="number" class="form-control" asp-for="@Model.Control!.Sensibilidad" /></div></div>
    <div class="form-group"><label>Dificultad</label><div class="col-6"><select class="form-control" asp-for="@Model.Control!.Dificultad"><option value="Facil">Facil</option><option value="Normal">Normal</option><option value="Dificil">Dificil</option></select></div></div>
    <div class="form-group"><label>Usuario</label><div class="col-6"><select class="form-control" asp-for="@Model.Control!.UsuarioId">@if (Model.ListaUsuarios != null) { @foreach (var u in Model.ListaUsuarios) { <option value="@u.Id">@u.Nombre @u.Apellido</option> } }</select></div></div>
}
@if (ViewData.ContainsKey("Mensaje")) { <div class="alert alert-danger mt-2">@ViewData["Mensaje"]</div> }
@if (Model.Control != null && Model.Borrando)
{
    <div class="popup"><div class="pp_ms_inner"><div style="width:95%"><h2 align="left">Mensaje</h2><h6 align="left">¿Desea borrar el Control?</h6><h6 align="left">@Model.Control!.Controles</h6>
    <input type="submit" value="Cerrar" asp-page-handler="BtCerrar" class="btn btn-secondary" />
    <input type="submit" value="Borrar" asp-page-handler="BtBorrar" class="btn btn-danger" /></div></div></div>
}
@if (Model.Lista != null && Model.Lista.Count > 0)
{
    <br /><table class="table table-striped table-bordered table-hover">
    <tr><th>Id</th><th>FPS</th><th>Controles</th><th>Sensibilidad</th><th>Dificultad</th><th>Acciones</th></tr>
    @foreach (var e in Model.Lista) {
        <tr><td>@e.Id</td><td>@e.Fps</td><td>@e.Controles</td><td>@e.Sensibilidad</td><td>@e.Dificultad</td>
        <td><input type="submit" value="Modificar" asp-page-handler="BtModificar" class="btn btn-warning btn-sm" asp-route-data="@e.Id" />
        <input type="submit" value="Borrar" asp-page-handler="BtBorrarVal" class="btn btn-danger btn-sm" asp-route-data="@e.Id" /></td></tr>
    }
    </table>
}
</form></div></center>