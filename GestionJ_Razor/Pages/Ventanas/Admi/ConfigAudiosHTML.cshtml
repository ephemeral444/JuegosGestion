@* Pages/Ventanas/Admi/ConfigAudiosHTML.cshtml *@
@page
@model GestionJ_Razor.Pages.Ventanas.Admi.ConfigAudiosHTMLModel
@{ ViewData["Title"] = "Config Audios"; }
<center><div><form method="POST" enctype="multipart/form-data">
@Html.AntiForgeryToken()
<div align="left"><h3>Configuraciones de Audio</h3></div>
<div>
    <input type="submit" value="Refrescar" class="btn btn-secondary" asp-page-handler="BtRefrescar" />
    <input type="submit" value="Nuevo" class="btn btn-secondary" asp-page-handler="BtNuevo" disabled="@(Model.ConfigAudio != null)" />
    <input type="submit" value="Guardar" class="btn btn-secondary" asp-page-handler="BtGuardar" disabled="@(Model.ConfigAudio == null)" />
</div>
@if (Model.ConfigAudio != null)
{
    <input type="hidden" asp-for="@Model.ConfigAudio!.Id" /><br />
    <div class="form-group"><label>Latencia</label><div class="col-6"><input class="form-control" asp-for="@Model.ConfigAudio!.Latencia" /></div></div>
    <div class="form-group"><label>Frecuencia</label><div class="col-6"><input class="form-control" asp-for="@Model.ConfigAudio!.Frecuencia" /></div></div>
    <div class="form-group"><label>Volumen</label><div class="col-6"><input type="number" class="form-control" asp-for="@Model.ConfigAudio!.Volumen" /></div></div>
    <div class="form-group"><label>Modo</label><div class="col-6"><select class="form-control" asp-for="@Model.ConfigAudio!.Modo"><option value="Estereo">Estereo</option><option value="Mono">Mono</option><option value="Surround">Surround</option></select></div></div>
    <div class="form-group"><label>Confi General</label><div class="col-6"><select class="form-control" asp-for="@Model.ConfigAudio!.ConfiGeneralId">@if (Model.ListaConfiGenerales != null) { @foreach (var c in Model.ListaConfiGenerales) { <option value="@c.Id">@c.Version - @c.Idioma</option> } }</select></div></div>
}
@if (ViewData.ContainsKey("Mensaje")) { <div class="alert alert-danger mt-2">@ViewData["Mensaje"]</div> }
@if (Model.ConfigAudio != null && Model.Borrando)
{
    <div class="popup"><div class="pp_ms_inner"><div style="width:95%"><h2 align="left">Mensaje</h2><h6 align="left">¿Desea borrar la Config Audio?</h6><h6 align="left">@Model.ConfigAudio!.Modo</h6>
    <input type="submit" value="Cerrar" asp-page-handler="BtCerrar" class="btn btn-secondary" />
    <input type="submit" value="Borrar" asp-page-handler="BtBorrar" class="btn btn-danger" /></div></div></div>
}
@if (Model.Lista != null && Model.Lista.Count > 0)
{
    <br /><table class="table table-striped table-bordered table-hover">
    <tr><th>Id</th><th>Latencia</th><th>Frecuencia</th><th>Volumen</th><th>Modo</th><th>Acciones</th></tr>
    @foreach (var e in Model.Lista) {
        <tr><td>@e.Id</td><td>@e.Latencia</td><td>@e.Frecuencia</td><td>@e.Volumen</td><td>@e.Modo</td>
        <td><input type="submit" value="Modificar" asp-page-handler="BtModificar" class="btn btn-warning btn-sm" asp-route-data="@e.Id" />
        <input type="submit" value="Borrar" asp-page-handler="BtBorrarVal" class="btn btn-danger btn-sm" asp-route-data="@e.Id" /></td></tr>
    }
    </table>
}
</form></div></center>